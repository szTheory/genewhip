# Read CMake's generated, per-target settings. No build/source paths are emitted.
include("${build}/EvidenceDriver.cmake")
file(GLOB indexes "${build}/.cmake/api/v1/reply/index-*.json")
list(SORT indexes ORDER DESCENDING)
if(NOT indexes)
  message(FATAL_ERROR "Missing generated evidence configuration codemodel")
endif()
list(GET indexes 0 index_path)
file(READ "${index_path}" index)
string(JSON model_file GET "${index}" reply codemodel-v2 jsonFile)
file(READ "${build}/.cmake/api/v1/reply/${model_file}" model)
string(JSON count LENGTH "${model}" configurations)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Evidence configuration requires exactly one generated configuration")
endif()
string(JSON name GET "${model}" configurations 0 name)
if(NOT name STREQUAL GW_ACTIVE_CONFIG)
  message(FATAL_ERROR "Evidence configuration does not match active build")
endif()
string(JSON count LENGTH "${model}" configurations 0 targets)
math(EXPR last "${count}-1")
set(required genewhip_core gw_build_rom gw_diagnostic_runner gw_validate_evidence)
set(effective "${driver_configuration}")
foreach(i RANGE 0 ${last})
  string(JSON name GET "${model}" configurations 0 targets ${i} name)
  if(NOT name IN_LIST required)
    continue()
  endif()
  string(JSON target_file GET "${model}" configurations 0 targets ${i} jsonFile)
  file(READ "${build}/.cmake/api/v1/reply/${target_file}" target)
  # Compile groups include resolved IPO/PIC, per-config and per-source options,
  # definitions, includes, language standard, sysroot and their source mapping.
  string(JSON groups GET "${target}" compileGroups)
  string(APPEND effective "\n${name}.compile=${groups}")
  string(JSON kind GET "${target}" type)
  if(kind STREQUAL "STATIC_LIBRARY")
    string(JSON commands GET "${target}" archive)
  else()
    string(JSON commands GET "${target}" link)
  endif()
  string(APPEND effective "\n${name}.link=${commands}")
  list(REMOVE_ITEM required "${name}")
endforeach()
if(required)
  message(FATAL_ERROR "Incomplete generated evidence target configuration: ${required}")
endif()
# Relocation must not turn identical builds into different configurations.
# Replace the build first since it can be nested beneath the source directory.
string(REPLACE "${build}" "<BUILD>" effective "${effective}")
string(REPLACE "${root}" "<SOURCE>" effective "${effective}")
string(APPEND configuration "\n${effective}")
