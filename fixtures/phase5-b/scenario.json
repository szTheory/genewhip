    "route_derivation": "Attempt 0 and 1 each hold Right until the current actor enters B01_PLATE_A, then remain neutral to timeout. Under-cap timeout commits automatically. At attempts 2 and 3, the two-echo cap opens the timeline; C selects cursor ordinal 0 and commits, with the runtime rejecting protected descriptors. Attempt 4 moves Up from y112 to y106, waits in the walkable corridor until observed tick500, then holds Right through tick671 to x288.5 along the generated y96\u2013111 doorway opening, and Down four steps to terminal y112. B begins at observed tick696; the next 24 consumed steps finish the terminal interaction at attempt4 tick720. Each prior timeout consumes 720 source ticks; the two UI replacement pauses consume none. No partial manual commit is used.",
    "engine_clock": {
      "attempt_address": "FF140E",
      "attempt_width_bytes": 2,
      "tick_address": "FF1410",
      "tick_width_bytes": 2,
      "state_address": "FF1408",
      "active_value": 1,
      "terminal_value": 2,
      "ticks_per_timeout": 720,
      "active_limit": 3600,
      "accounting": "One per observed completed GameplayStep at phase-idle write, strictly next source tick in same/new attempt; no assumed suffixes, no reset/UI ticks."
    },
    "campaign_inputs": {
      "entry": "GameplayInitialize -> CampaignLoadEncounter directory index 0 (B01)",
      "boot_echo_cap": 2,
      "spawn_px": [
        32,
        112
      ],
      "switch": "B01_PLATE_A center (64,112), half extent 8, occupancy 1 frame",
      "door": "B01_DOOR_A at (160,96), generated dependency from plate occupancy",
      "terminal": "B01_COMMIT at (288,112), interact_frames 24",
      "speed": "cardinal 0x180 16.8 = 1.5 px per consumed tick"
    },
    "observation_repair": "Source phase-idle write observer captures after actor/device/tick/result work, before next input poll; initial tick0 active targets are dispatched at first completedtick1. Existing target thresholds/oracle bytes remain unchanged and frozen before diagnostic."
  },
